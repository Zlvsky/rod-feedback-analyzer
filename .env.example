# Required only for real integration. Leave secrets out of git.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_FEEDBACK_CHANNEL_ID=
DISCORD_GENERAL_EN_CHANNEL_ID=
TRELLO_API_KEY=
TRELLO_TOKEN=
TRELLO_BOARD_ID=
TRELLO_LIST_ID=

# Safe initial setting: only explicit false enables real Trello writes.
DRY_RUN=true
# Local storage path; use an absolute path for scheduled local runs.
DATA_DIR=./data
INITIAL_LOOKBACK_DAYS=7
COLLECTION_OVERLAP_MINUTES=60
CONTEXT_MESSAGES=3
HTTP_MAX_RETRIES=4
HTTP_TIMEOUT_MS=20000
# Explicit mock mode always uses data/mock (or --data-dir) and never the network.
MOCK_MODE=false
